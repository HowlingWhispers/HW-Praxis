{
  "name": "Praxis",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  "postCreateCommand": "npm ci",
  "postAttachCommand": "npm run dev:all",
  "forwardPorts": [5176],
  "portsAttributes": {
    "5176": { "label": "Praxis", "onAutoForward": "openBrowser" },
    "8791": { "label": "Praxis API (internal)", "onAutoForward": "silent" }
  },
  "hostRequirements": { "cpus": 2 }
}
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "vitest.explorer"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  },
  "forwardPorts": [5176, 8791],
  "postCreateCommand": "npm ci",
  "remoteUser": "node"
}
