{
  "name": "Praxis",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "vitest.explorer"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  },
  "remoteUser": "node",
  "postCreateCommand": "npm ci",
  "postStartCommand": "setsid nohup bash scripts/codespace-start.sh > /dev/null 2>&1 &",
  "forwardPorts": [8791, 5176],
  "portsAttributes": {
    "8791": { "label": "Praxis", "onAutoForward": "openBrowser" },
    "5176": { "label": "Dev server (npm run dev:all)", "onAutoForward": "silent" }
  },
  "hostRequirements": { "cpus": 2 }
}
